# ─────────────────────────────────────────────────────────────────────────────
# rashedbin.com — environment variables
# Copy to .env.local for development. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser; everything else
# is server-only.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical public URL (no trailing slash). Used for canonical tags, sitemap,
# Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://rashedbin.com

# Set to "true" only on the production deployment. Anything else adds a
# site-wide noindex so preview deployments are never indexed.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ── Supabase (database + auth) ───────────────────────────────────────────────
# Local: run `pnpm db:start`, then copy values from `npx supabase status`
# (API_URL, PUBLISHABLE_KEY, SECRET_KEY).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses Row Level Security — never expose, never prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ── Email ────────────────────────────────────────────────────────────────────
# Provider: "resend" (production) or "mailpit" (local inbox at http://127.0.0.1:54324).
EMAIL_PROVIDER=mailpit
# Safety switch: "log" (never send), "allowlist" (only EMAIL_ALLOWLIST), "live".
# Production must set "live" explicitly. Default when unset: log.
EMAIL_MODE=log
# Comma-separated addresses or domains (e.g. "you@gmail.com,@example.test").
EMAIL_ALLOWLIST=
EMAIL_FROM="Rashed <hello@rashedbin.com>"
EMAIL_REPLY_TO=hello@rashedbin.com
# Absolute origin used for links inside emails (resume links, dashboard links).
APP_URL=http://localhost:3000
# RESEND_API_KEY=                     # server only
# RESEND_WEBHOOK_SECRET=              # whsec_… from the Resend webhook settings
# MAILPIT_URL=http://127.0.0.1:54324

# ── Abuse protection ─────────────────────────────────────────────────────────
# Cloudflare Turnstile. Leave both empty locally to skip the check.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Secret salt for hashing IP addresses (rate limiting). Use a long random value.
IP_HASH_SALT=

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". At least 16 characters.
CRON_SECRET=

# ── Analytics (Phase 7) ──────────────────────────────────────────────────────
# NEXT_PUBLIC_ANALYTICS_DOMAIN=

# ── Local testing only ───────────────────────────────────────────────────────
# PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium
