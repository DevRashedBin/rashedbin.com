# ─────────────────────────────────────────────────────────────────────────────
# rashedbin.com — environment variables
# Copy to .env.local for development. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser; everything else
# is server-only.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical public URL (no trailing slash). Used for canonical tags, sitemap,
# Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://rashedbin.com

# Set to "true" only on the production deployment. Anything else adds a
# site-wide noindex so preview deployments are never indexed.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ── Supabase (database + auth) ───────────────────────────────────────────────
# Local: run `pnpm db:start`, then copy values from `npx supabase status`
# (API_URL, PUBLISHABLE_KEY, SECRET_KEY).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses Row Level Security — never expose, never prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ── Phase 4: Email (Resend) + spam protection ────────────────────────────────
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# EMAIL_FROM="Rashed <hello@mail.rashedbin.com>"
# EMAIL_ADMIN_NOTIFY=
# EMAIL_MODE=log                      # log | allowlist | live
# EMAIL_ALLOWLIST=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ── Phase 6/7: scheduled jobs, analytics ─────────────────────────────────────
# CRON_SECRET=
# NEXT_PUBLIC_ANALYTICS_DOMAIN=

# ── Local testing only ───────────────────────────────────────────────────────
# PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium
